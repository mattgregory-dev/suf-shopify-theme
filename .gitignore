node_modules/

# Sass build artifacts. assets/suf.css is NOT committed -- it changes on every
# style edit and the diff noise is not worth it. Consequence: a clean clone has
# no compiled CSS, so build before pushing. Use `npm run preview`, which does.
assets/suf.css
assets/suf.css.map
.sass-cache/

# Python bytecode, from running bin/ scripts.
__pycache__/

# Assistant context files. Kept locally, deliberately not versioned: they are
# tooling for whichever coding agent a developer happens to use, not part of
# the theme. Nothing in the theme depends on them.
CLAUDE.md
AGENTS.md
GEMINI.md
.cursorrules
.github/copilot-instructions.md
