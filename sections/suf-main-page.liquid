{% comment %}
  Main content section for a page on layout/suf.liquid.

  The suf equivalent of main-page, and like main-page it has no presets: it is
  the one mandatory content section for a suf page template, so it should not be
  addable to arbitrary pages from the editor.

  page.content is merchant-authored HTML from the Shopify rich text editor. It
  is styled by the .rte rules in _suf-page.scss rather than left to the browser.
{% endcomment %}

<article class="suf-page">
  <div class="suf-page__inner">
    {%- if section.settings.show_title and page.title != blank -%}
      <h1 class="suf-page__title">{{ page.title }}</h1>
    {%- endif -%}

    {%- if page.content != blank -%}
      <div class="suf-page__content rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Page content (SUF)",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ]
}
{% endschema %}
