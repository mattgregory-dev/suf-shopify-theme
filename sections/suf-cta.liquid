{% comment %}
  Closing call-to-action band.

  The mirror of suf-page-band: that one opens a page with a red rule beneath
  it, this one closes a page with a red rule above it. Almost every interior
  page ends with this.

  HEADING SIZE. The default is the smaller of the two, because nearly every
  CTA headline in this design is a full sentence. `large_heading` is the
  exception, for a short line -- currently only the homepage.

  ONE PRIMARY button. The design rations red to one filled button per section.
  A second action is available, but only as the outline (ghost) button or as a
  text link -- never a second red one.

  ELEMENT. The root here is a <div>, not a <section>: the schema's
  `"tag": "section"` already makes Shopify wrap this in
  <section id="shopify-section-...">, and a <section> of our own inside that
  would nest two sectioning elements for one band. Same pattern as
  suf-main-page (<article>) and suf-footer (<footer>).
{% endcomment %}

<div class="suf-cta">
  <div class="suf-wrap">
    {%- if section.settings.heading != blank -%}
      <h2{% if section.settings.large_heading %} class="suf-cta__heading--large"{% endif %}>
        {%- assign h = section.settings.heading | escape -%}
        {%- render 'suf-nb', text: h -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.subhead != blank -%}
      <p class="suf-cta__subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="suf-btnrow">
        {%- if section.settings.button_label != blank -%}
          <a
            class="suf-btn suf-btn--primary"
            {% if section.settings.button_url != blank %}
              href="{{ section.settings.button_url }}"
            {% else %}
              href="#"
              aria-disabled="true"
            {% endif %}
          >
            {%- assign bl = section.settings.button_label | escape -%}
            {%- render 'suf-nb', text: bl -%}
          </a>
        {%- endif -%}

        {%- if section.settings.button2_label != blank and section.settings.button2_url != blank -%}
          <a class="suf-btn suf-btn--ghost suf-btn--on-dark" href="{{ section.settings.button2_url }}">
            {%- assign bl2 = section.settings.button2_label | escape -%}
            {%- render 'suf-nb', text: bl2 -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <a class="suf-link" href="{{ section.settings.link_url }}">
        {{- section.settings.link_label | escape -}}
      </a>
    {%- endif -%}

    {%- if section.settings.micro != blank -%}
      <p class="suf-cta__micro">{{ section.settings.micro | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "CTA band (SUF)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to start?"
    },
    {
      "type": "checkbox",
      "id": "large_heading",
      "label": "Large heading",
      "info": "The default size suits a full-sentence headline. Turn this on only for a short, punchy line -- the homepage. A long headline at this size wraps to three lines.",
      "default": false
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Primary action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Button label",
      "info": "Renders as the outline button. The design allows one filled red button per section, so this is never a second primary."
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "micro",
      "label": "Fine print"
    }
  ],
  "presets": [
    {
      "name": "CTA band (SUF)"
    }
  ]
}
{% endschema %}
