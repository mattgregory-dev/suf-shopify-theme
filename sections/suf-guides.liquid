{% comment %}
  Product cards for the study guides page.

  REAL COMMERCE. Each block picks a product and renders a working add-to-cart
  form. The card carries no link at all, deliberately: it is a complete
  purchase surface -- copy, price, variant and button -- so sending anyone to
  the product page would only add a step. The product is still picked, because
  price, variants and availability come from it.

  The mockup's card is a whole-card <a> around a faux
  <span class="btn">Add to Cart</span>. That could not survive either way: a
  <form> cannot be nested inside an <a>.

  Copy falls back to the product's own fields, so a card renders sensibly the
  moment a product is picked and the overrides exist only for when the
  marketing copy should differ from the catalogue.

  VARIANTS. A product with one variant posts a hidden id. A product with
  several renders a labelled <select name="id">, which is the whole variant
  picker -- no JavaScript, because price is not per-variant on either of these
  products. If a future product prices variants differently, this needs a
  price-updating script; it does not have one.

  A block with no product selected renders its copy without price or button,
  so the page still builds while a product is being set up.

  THE STRIP is an optional fact bar under the cards -- a figure, a paragraph
  and two label/value rows. It lives on this section rather than in one of its
  own because it has to sit tight under the cards (one small gap, not a full
  section's padding), and it is part of the same offer: on the SUF-CPT page it
  is what used to be a whole "Certified for Life" section, compressed to the
  one number that mattered. It renders only when its figure is filled.

  ELEMENT. The root is a <div>: `"tag": "section"` already wraps this.
{% endcomment %}

{%- liquid
  assign classes = 'suf-section'
  if section.settings.anchor != blank
    assign classes = classes | append: ' suf-anchor-target'
  endif
-%}

<div class="{{ classes }}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="suf-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="suf-section__head">
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.aside != blank -%}
          <p class="suf-section__aside">{{ section.settings.aside | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="suf-guidegrid{% if section.settings.narrow %} suf-guidegrid--narrow{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign heading = block.settings.heading | default: product.title
          assign body = block.settings.body | default: product.description
        -%}
        <div
          class="suf-gcard{% if block.settings.image != blank %} suf-gcard--media{% endif %}{% if block.settings.featured %} suf-gcard--featured{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.featured and block.settings.flag != blank -%}
            <span class="suf-gcard__flag">{{ block.settings.flag | escape }}</span>
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            <div class="suf-gcard__img">
              {{
                block.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000',
                  sizes: '(min-width: 901px) 45vw, 90vw',
                  alt: block.settings.image_alt
              }}
            </div>
          {%- endif -%}

          <div class="suf-gcard__inner">
          {%- if heading != blank -%}
            <h3>{{ heading | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.meta != blank -%}
            <p class="suf-gcard__meta">{{ block.settings.meta | escape }}</p>
          {%- endif -%}

          {%- if body != blank -%}
            <p class="suf-gcard__body">{{ body | strip_html | escape }}</p>
          {%- endif -%}

          {%- if product != blank -%}
            <p class="suf-gcard__price">{{ product.price | money_without_trailing_zeros }}</p>

            {%- if product.available -%}
              {%- form 'product', product, class: 'suf-gcard__form' -%}
                {%- if product.variants.size > 1 -%}
                  <div class="suf-gcard__variants">
                    <label for="suf-variant-{{ block.id }}">
                      {{- block.settings.variant_label | default: 'Option' | escape -}}
                    </label>
                    <select id="suf-variant-{{ block.id }}" name="id">
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          {% unless variant.available %}disabled{% endunless %}
                        >
                          {{- variant.title -}}
                          {%- unless variant.available %} — sold out{% endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {%- endif -%}

                {%- if block.settings.go_to_checkout -%}
                  <input type="hidden" name="return_to" value="/checkout">
                {%- endif -%}
                <button type="submit" class="suf-btn suf-btn--primary" name="add">
                  {{- block.settings.button_label | default: 'Add to Cart' | escape -}}
                </button>
              {%- endform -%}
            {%- else -%}
              <p class="suf-gcard__soldout">Sold out</p>
            {%- endif -%}
          {%- endif -%}

          {%- if block.settings.micro != blank -%}
            <p class="suf-btn-micro">{{ block.settings.micro | escape }}</p>
          {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.strip_figure != blank -%}
      <div class="suf-lifebar">
        <div class="suf-lifebar__figure">
          <p class="suf-lifebar__big">{{ section.settings.strip_figure | escape }}</p>
          {%- if section.settings.strip_label != blank -%}
            <p class="suf-lifebar__cap">{{ section.settings.strip_label | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.strip_body != blank -%}
          <div class="suf-lifebar__body">
            {%- render 'suf-nb', text: section.settings.strip_body -%}
          </div>
        {%- endif -%}

        {%- assign strip_rows = section.settings.strip_rows | strip | newline_to_br | split: '<br />' -%}
        {%- if strip_rows.size > 0 -%}
          <div class="suf-lifebar__rows">
            {%- for row in strip_rows -%}
              {%- assign parts = row | strip | split: '|' -%}
              {%- if parts.size > 1 -%}
                {%- assign row_label = parts[0] | strip | escape -%}
                <p class="suf-lifebar__row">
                  <b>{% render 'suf-nb', text: row_label %}</b>
                  <span>{{ parts[1] | strip }}</span>
                </p>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      {%- comment -%}
        A <div>, not a <p>: a richtext setting emits its own <p>, and nesting
        one inside another is invalid -- the browser auto-closes the outer
        element and the content escapes the styled wrapper entirely.
      {%- endcomment -%}
      <div class="suf-guidenote">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product cards (SUF)",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "aside",
      "label": "Supporting note",
      "info": "Sits right-aligned beside the heading."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "info": "Lets a button elsewhere on the page link to this section, e.g. \"guides\" for #guides."
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Cap the grid at 1000px",
      "info": "For cards with images -- two of them look stretched across the full container.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note under the cards",
      "info": "Centred fine print, e.g. the refund policy."
    },
    { "type": "header", "content": "Strip under the cards" },
    {
      "type": "text",
      "id": "strip_figure",
      "label": "Figure",
      "info": "Fill this to show the strip, e.g. \"$X\". Leave empty and the strip does not render."
    },
    { "type": "text", "id": "strip_label", "label": "Figure label" },
    { "type": "richtext", "id": "strip_body", "label": "Strip body" },
    {
      "type": "textarea",
      "id": "strip_rows",
      "label": "Strip rows",
      "info": "One per line as label|value. Wrap a value in <em> to accent it."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Price, variants and availability come from this. The card does not link to the product page -- it sells in place. Leave empty to render copy only."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading override",
          "info": "Defaults to the product title."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta line",
          "info": "Small caps line under the heading."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body override",
          "info": "Defaults to the product description."
        },
        {
          "type": "text",
          "id": "variant_label",
          "label": "Variant picker label",
          "info": "Only shown when the product has more than one variant.",
          "default": "Option"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Add to Cart"
        },
        {
          "type": "text",
          "id": "micro",
          "label": "Fine print under the button"
        },
        {
          "type": "checkbox",
          "id": "go_to_checkout",
          "label": "Go straight to checkout",
          "info": "Skips the cart. Right for a single high-value purchase; wrong on a page that sells more than one thing.",
          "default": false
        },
        { "type": "image_picker", "id": "image", "label": "Card image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured",
          "info": "Navy card with a flag. Use on ONE card only.",
          "default": false
        },
        { "type": "text", "id": "flag", "label": "Flag text", "default": "Most Popular" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product cards (SUF)",
      "blocks": [{ "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
