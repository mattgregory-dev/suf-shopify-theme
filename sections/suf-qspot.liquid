{% comment %}
  Dark band: a headline quote, the outcome it produced, the longer quote behind
  it, and a photo.

  The structure is the argument. The short quote is the claim, the result badge
  is the number, and the long quote is the evidence -- in that order, because a
  reader who stops after the badge has still got the point.

  Full-bleed navy carrying its own rhythm through margin-block, so it does NOT
  take .suf-section. Count the dark bands on the page before adding it.

  PROOF BLOCKS. Optional testimonial cards under the spotlight, inside the same
  band -- the same device as the split fact section on SUF-CPT, and for the
  same reason: on a dark band the quotes are part of the same argument, and two
  adjacent full-bleed navy sections would have to be made to abut by hand.

  ELEMENT. The root is a <div>: `"tag": "section"` already wraps this.
{% endcomment %}

<div class="suf-qspot">
  <div class="suf-wrap">
    <div class="suf-qspot__inner">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="suf-eyebrow">{% render 'suf-nb', text: section.settings.eyebrow %}</p>
        {%- endif -%}

        {%- if section.settings.headline != blank -%}
          <div class="suf-bigquote">
            <blockquote>
              <p>{{ section.settings.headline | escape }}</p>
            </blockquote>
          </div>
        {%- endif -%}

        {%- if section.settings.result != blank -%}
          <p class="suf-qspot__result">{{ section.settings.result | escape }}</p>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote>
            <p class="suf-qspot__quote">{{ section.settings.quote | escape }}</p>
          </blockquote>
        {%- endif -%}

        {%- if section.settings.who != blank -%}
          <p class="suf-qspot__who">{{ section.settings.who | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="suf-qspot__media">
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '520, 700, 1000',
              sizes: '(min-width: 901px) 40vw, 90vw',
              alt: section.settings.image_alt
          }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="suf-qspot__proof">
        {%- if section.settings.proof_heading != blank -%}
          {%- comment -%}
            Escaped BEFORE suf-nb: these are plain text/textarea settings and
            suf-nb inserts markup, so escaping after would escape its own spans
            back into visible text.
          {%- endcomment -%}
          {%- assign proof_heading = section.settings.proof_heading | escape -%}
          <p class="suf-qspot__prooflabel">{% render 'suf-nb', text: proof_heading %}</p>
        {%- endif -%}

        <div class="suf-quotegrid suf-quotegrid--two">
          {%- for block in section.blocks -%}
            <div class="suf-qcard" {{ block.shopify_attributes }}>
              {%- assign rating = block.settings.rating | plus: 0 -%}
              {%- if rating > 0 -%}
                <p class="suf-qcard__stars" aria-hidden="true">
                  {%- for i in (1..rating) -%}★{%- endfor -%}
                </p>
                <p class="suf-visually-hidden">Rated {{ rating }} out of 5</p>
              {%- endif -%}

              {%- if block.settings.quote != blank -%}
                {%- assign quote = block.settings.quote | escape -%}
                <blockquote class="suf-qcard__quote">
                  <p>{% render 'suf-nb', text: quote %}</p>
                </blockquote>
              {%- endif -%}

              {%- if block.settings.who != blank -%}
                <p class="suf-qcard__who">{{ block.settings.who | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Quote spotlight (SUF)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline quote",
      "info": "Short. This is the claim; the long quote below is the evidence."
    },
    {
      "type": "text",
      "id": "result",
      "label": "Result",
      "info": "The outcome, as a badge, e.g. \"Generated $X,XXX in new business\"."
    },
    { "type": "textarea", "id": "quote", "label": "Full quote" },
    { "type": "text", "id": "who", "label": "Attribution" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_alt", "label": "Photo alt text" },
    { "type": "header", "content": "Proof" },
    {
      "type": "text",
      "id": "proof_heading",
      "label": "Testimonial label",
      "info": "Shown above the quotes. Add Quote blocks to fill the row."
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "0 hides the stars."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Quotation marks are added by the design -- do not type them."
        },
        { "type": "text", "id": "who", "label": "Attribution" }
      ]
    }
  ],
  "presets": [{ "name": "Quote spotlight (SUF)" }]
}
{% endschema %}
