{% comment %}
  Two-column text/image split with an offset frame.

  One section for what the mockup writes four times (.whyZ, .founder, .teaser,
  .certrow). Image side, frame colour and crop are settings.

  FRAME COLOUR ALTERNATES. Per the design notes the red and blue frames swap
  down a page so two adjacent spotlights never share one. Nothing can enforce
  that across sections, so check the page, not just this section.

  The frame's SIDE is not configurable: it always sits on the inner edge,
  facing the text, and CSS derives that from the image side.

  ORDER. The markup is always text-then-image; putting the image first is done
  with CSS order, so reading and tab order stay correct regardless of the
  visual arrangement. Below 1000px the image always follows the text.

  TWO BLOCK TYPES. `feature` renders the blue slash-bullet list between the
  copy and the button. `resource` renders link cards under it -- a cited book, a
  report, a download -- each a whole-card <a> with no nested interactive
  content, so one anchor carries the whole card.

  ELEMENT. The root is a <div>: `"tag": "section"` already wraps this.
{% endcomment %}

{%- liquid
  assign classes = 'suf-section suf-spotlight'
  if section.settings.image_side == 'left'
    assign classes = classes | append: ' suf-spotlight--image-left'
  endif
  if section.settings.frame != 'none'
    assign classes = classes | append: ' suf-spotlight--frame-' | append: section.settings.frame
  endif
  if section.settings.wide
    assign classes = classes | append: ' suf-spotlight--wide'
  endif
  if section.settings.uncropped
    assign classes = classes | append: ' suf-spotlight--uncropped'
  endif
-%}

<div class="{{ classes }}">
  <div class="suf-wrap">
    <div class="suf-spotlight__inner">
      <div class="suf-spotlight__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="suf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2>{% render 'suf-nb', text: section.settings.heading %}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="suf-spotlight__lead">{% render 'suf-nb', text: section.settings.body %}</div>
        {%- endif -%}

        {%- assign features = section.blocks | where: 'type', 'feature' -%}
        {%- if features.size > 0 -%}
          <ul class="suf-whylist">
            {%- for block in features -%}
              {%- if block.settings.text != blank -%}
                <li {{ block.shopify_attributes }}>{% render 'suf-nb', text: block.settings.text %}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
          <div class="suf-btnrow">
            <a
              class="suf-btn suf-btn--{{ section.settings.button_style }}"
              href="{{ section.settings.button_url }}"
            >
              {%- render 'suf-nb', text: section.settings.button_label -%}
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.micro != blank -%}
          <div class="suf-btn-micro">{% render 'suf-nb', text: section.settings.micro %}</div>
        {%- endif -%}

        {%- assign resources = section.blocks | where: 'type', 'resource' -%}
        {%- if resources.size > 0 -%}
          <div class="suf-resources">
            {%- for block in resources -%}
              {%- liquid
                assign has_link = false
                if block.settings.url != blank
                  assign has_link = true
                endif
              -%}
              {%- if has_link -%}
                <a class="suf-resource" href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
              {%- else -%}
                <div class="suf-resource" {{ block.shopify_attributes }}>
              {%- endif -%}

              {%- if block.settings.image != blank -%}
                <div class="suf-resource__cover">
                  {{
                    block.settings.image
                    | image_url: width: 300
                    | image_tag: loading: 'lazy', widths: '150, 300', alt: block.settings.image_alt
                  }}
                </div>
              {%- endif -%}

              <div class="suf-resource__body">
                {%- if block.settings.title != blank -%}
                  <h4>{{ block.settings.title }}</h4>
                {%- endif -%}
                {%- if block.settings.meta != blank -%}
                  <p class="suf-resource__meta">{{ block.settings.meta | escape }}</p>
                {%- endif -%}
                {%- assign rating = block.settings.rating | plus: 0 -%}
                {%- if rating > 0 -%}
                  <p class="suf-resource__stars">
                    <span aria-hidden="true">{% for i in (1..rating) %}★{% endfor %}</span>
                    <span class="suf-visually-hidden">Rated {{ rating }} out of 5</span>
                    {%- if block.settings.rating_note != blank -%}
                      <b>{{ block.settings.rating_note | escape }}</b>
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>

              {%- if has_link -%}</a>{%- else -%}</div>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="suf-spotlight__media">
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 900',
              sizes: '(min-width: 1001px) 40vw, 90vw',
              alt: section.settings.image_alt
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Spotlight (SUF)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe what is happening in the photo, not just who is in it."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image side",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "frame",
      "label": "Offset frame",
      "info": "BLUE when the image is on the left, RED when it is on the right. Follow the image side, not the section above -- that is the convention across the site.",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "blue", "label": "Blue" },
        { "value": "none", "label": "None" }
      ],
      "default": "red"
    },
    {
      "type": "checkbox",
      "id": "wide",
      "label": "Landscape crop",
      "info": "Use for a photo that does not crop well to a portrait 4:5.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uncropped",
      "label": "Do not crop the image",
      "info": "Constrains the photo by width only and keeps its own proportions. Overrides the landscape crop.",
      "default": false
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "info": "Use the outline unless this spotlight is the page's main action -- the design allows one filled red button per section.",
      "options": [
        { "value": "ghost", "label": "Outline" },
        { "value": "primary", "label": "Filled red" }
      ],
      "default": "ghost"
    },
    {
      "type": "richtext",
      "id": "micro",
      "label": "Fine print under the button",
      "info": "Small muted line. May contain a link."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Feature",
          "info": "Bold the first few words -- the list is scanned, not read."
        }
      ]
    },
    {
      "type": "resource",
      "name": "Linked resource",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Cover alt text"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "info": "Italicise a book or publication title with the editor's italic control."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta line",
          "info": "Author, year, publisher."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0,
          "info": "0 hides the stars."
        },
        {
          "type": "text",
          "id": "rating_note",
          "label": "Note beside the rating"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link",
          "info": "Opens in a new tab. Leave blank for a non-clickable card."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spotlight (SUF)"
    }
  ]
}
{% endschema %}
