{% comment %}
  The dark opener for an interior page on layout/suf.liquid.

  Two tiers, per the redesign's header tier system:

    tier 2  sales pages     display-size h1, left aligned
    tier 3  utility pages   h2-size h1, centred  (tier_3 = true)

  The homepage is tier 1 -- a full-bleed photo hero -- and is a different
  section entirely. Do not add a tier here for it.

  A tier-2 band may carry a photo, which bleeds to the band's right edge. It is
  loaded eagerly with high fetchpriority: on the pages that have one it is the
  largest contentful paint, and lazy-loading it delays the metric it defines.

  BOTTOM EDGE. A band either carries a red base rule or has the next section
  overlap it, never both. Turning on `overlap` removes the rule here and
  requires the FOLLOWING section to carry .suf-section--overlap-up; the two
  pull against each other by the same 110px and are meaningless apart. Nothing
  can enforce that from inside this section, hence this note.

  The heading is a rich text field so an <em> can mark the one blue value
  phrase. That highlight is suppressed on tier 3 by CSS, where the headline is
  a label rather than a pitch.

  ELEMENT. The root here is a <div>, not a <section>: the schema's
  `"tag": "section"` already makes Shopify wrap this in
  <section id="shopify-section-...">, and a <section> of our own inside that
  would nest two sectioning elements for one band. Same pattern as
  suf-main-page (<article>) and suf-footer (<footer>).
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading
  assign classes = 'suf-band'
  if section.settings.tier_3
    assign classes = classes | append: ' suf-band--compact'
  endif
  if section.settings.overlap
    assign classes = classes | append: ' suf-band--backdrop'
  endif
  if section.settings.image != blank and section.settings.tier_3 == false
    assign classes = classes | append: ' suf-band--split'
  endif
-%}

<div class="{{ classes }}">
  <div class="suf-wrap">
    <div class="suf-band__text">
    {%- if section.settings.eyebrow != blank -%}
      <p class="suf-eyebrow">{% render 'suf-nb', text: section.settings.eyebrow %}</p>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1>{% render 'suf-nb', text: heading %}</h1>
    {%- endif -%}

    {%- if section.settings.subhead != blank -%}
      <p class="suf-band__subhead">{% render 'suf-nb', text: section.settings.subhead %}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank or section.settings.button2_label != blank -%}
      <div class="suf-btnrow">
        {%- if section.settings.button_label != blank -%}
          <a
            class="suf-btn suf-btn--primary"
            {% if section.settings.button_url != blank %}
              href="{{ section.settings.button_url }}"
            {% else %}
              href="#"
              aria-disabled="true"
            {% endif %}
          >
            {%- assign bl = section.settings.button_label | escape -%}
            {%- render 'suf-nb', text: bl -%}
          </a>
        {%- endif -%}

        {%- if section.settings.button2_label != blank and section.settings.button2_url != blank -%}
          <a class="suf-btn suf-btn--ghost suf-btn--on-dark" href="{{ section.settings.button2_url }}">
            {%- assign bl2 = section.settings.button2_label | escape -%}
            {%- render 'suf-nb', text: bl2 -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.micro != blank -%}
      <p class="suf-band__micro">{% render 'suf-nb', text: section.settings.micro %}</p>
    {%- endif -%}
    </div>

    {%- if section.settings.image != blank and section.settings.tier_3 == false -%}
      <div class="suf-band__media">
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '520, 700, 1000',
            sizes: '(min-width: 901px) 45vw, 90vw',
            alt: section.settings.image_alt
        }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page band (SUF)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Short label above the heading. Rendered in caps with a red slash."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Page heading"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "tier_3",
      "label": "Compact (utility page)",
      "info": "Centred, smaller heading. Use for About, Team, Contact, Compare and the legal pages.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "overlap",
      "label": "Let the next section overlap this band",
      "info": "Removes the red base rule. The section below MUST have its overlap setting turned on too, or the layout will have a gap.",
      "default": false
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button label",
      "info": "Renders as the outline button. Never a second filled red one."
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "micro",
      "label": "Fine print",
      "info": "Small muted line under the button."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Tier 2 only -- the photo bleeds to the band's right edge. Ignored on a compact band."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo alt text"
    }
  ],
  "presets": [
    {
      "name": "Page band (SUF)"
    }
  ]
}
{% endschema %}
