{% comment %}
  Success story cards. One block per story.

  The figure leads because it is what a scanning reader stops on. It is blue,
  not red -- red is reserved for actions in this design, and a number is not an
  action.

  THE DISCLAIMER IS NOT OPTIONAL WHEN THE FIGURES ARE EARNINGS. Income claims
  attached to named or described individuals need a qualifier stating these are
  not typical results. The mockup's wireframe also carries an unresolved note:
  the two stories and their figures came from Chris and need confirming, and
  either permission for names and photos or the anonymous framing used here.
  That is a content decision, not a code one.

  ELEMENT. The root is a <div>: `"tag": "section"` already wraps this.
{% endcomment %}

<div class="suf-section suf-stories">
  <div class="suf-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="suf-section__head">
        <h2>{% render 'suf-nb', text: section.settings.heading %}</h2>
        {%- if section.settings.aside != blank -%}
          <p class="suf-section__aside">{% render 'suf-nb', text: section.settings.aside %}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="suf-storygrid">
      {%- for block in section.blocks -%}
        <div class="suf-story" {{ block.shopify_attributes }}>
          {%- if block.settings.figure != blank -%}
            <p class="suf-story__fig">{{ block.settings.figure | escape }}</p>
          {%- endif -%}

          {%- if block.settings.figure_label != blank -%}
            <p class="suf-story__figlbl">{% render 'suf-nb', text: block.settings.figure_label %}</p>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3>{% render 'suf-nb', text: block.settings.heading %}</h3>
          {%- endif -%}

          {%- if block.settings.body != blank -%}
            <div class="suf-story__body">{% render 'suf-nb', text: block.settings.body %}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="suf-stories__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Success stories (SUF)",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "aside",
      "label": "Supporting note"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "info": "Required whenever the figures are earnings. State that results are not typical or guaranteed."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "text",
          "id": "figure",
          "label": "Figure",
          "info": "The headline number, e.g. \"$XXK+\" or \"3 months\"."
        },
        {
          "type": "text",
          "id": "figure_label",
          "label": "Figure label",
          "info": "What the number means."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Story"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Success stories (SUF)",
      "blocks": [{ "type": "story" }, { "type": "story" }]
    }
  ]
}
{% endschema %}
