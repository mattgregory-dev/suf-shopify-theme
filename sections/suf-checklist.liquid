{% comment %}
  A two-column list of slash bullets -- "what's included".

  A <ul> with the markers removed, not a grid of divs: it is a list, and it
  should announce as one with a count. The two columns are presentation.

  Items are one per line in a textarea rather than blocks. Six one-line items
  is six add-block clicks and six panels to scroll for no gain.

  ELEMENT. The root is a <div>: `"tag": "section"` already wraps this.
{% endcomment %}

{%- assign lines = section.settings.items | strip | newline_to_br | split: '<br />' -%}

<div class="suf-section">
  <div class="suf-wrap">
    {%- if lines.size > 0 -%}
      <ul class="suf-checklist">
        {%- for line in lines -%}
          {%- assign item = line | strip -%}
          {%- if item != blank -%}
            <li>{% render 'suf-nb', text: item %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Checklist (SUF)",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "items",
      "label": "Items",
      "info": "One per line. Blank lines are ignored. Pair with a Statement section above for the heading."
    }
  ],
  "presets": [{ "name": "Checklist (SUF)" }]
}
{% endschema %}
