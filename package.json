{
  "private": true,
  "scripts": {
    "dev": "npm run css:watch",
    "css:watch": "sass --watch frontend/styles/main.scss:assets/suf.css --style=expanded --embed-sources",
    "css:build": "sass frontend/styles/main.scss:assets/suf.css --style=compressed --no-source-map",
    "pull": "shopify theme pull --theme 000000000000 --only \"templates/*.json\" --only \"config/settings_data.json\"",
    "predeploy": "echo '\\n  Did you npm run pull first? A push overwrites merchant edits.\\n'",
    "deploy": "npm run css:build && shopify theme push --theme 000000000000 --allow-live",
    "lint": "shopify theme check",
    "lint:json": "shopify theme check --output json",
    "lint:css": "stylelint \"frontend/styles/**/*.scss\"",
    "lint:css:fix": "stylelint \"frontend/styles/**/*.scss\" --fix",
    "format": "prettier --write frontend assets/suf.js",
    "format:check": "prettier --check frontend assets/suf.js",
    "audit:css": "python3 bin/audit-css-specificity.py"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "sass": "^1.93.4",
    "stylelint": "^17.14.1"
  }
}
