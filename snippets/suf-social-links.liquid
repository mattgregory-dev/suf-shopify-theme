{% comment %}
  Social links, read from the theme settings the legacy footer already uses, so
  there is a single place to change a URL. Only links that are set render.

  Each <a> is icon-only, so the icon carries an aria-label rather than being
  hidden from assistive tech.
{% endcomment %}
{%- liquid
  # YouTube and Spotify lead. Only links that are set render, so an order
  # longer than the shop's actual list costs nothing.
  #
  # Spotify is the podcast, and NOT one of the theme's inherited networks --
  # social_spotify_link lives in config/settings_schema.json and its glyph in
  # suf-icon.liquid, so it will not appear until a URL is entered under Theme
  # settings > Social.
  assign networks = 'youtube,spotify,instagram,facebook,twitter,linkedin,pinterest' | split: ','
-%}
<ul class="suf-social" role="list">
  {%- for network in networks -%}
    {%- assign key = 'social_' | append: network | append: '_link' -%}
    {%- assign url = settings[key] -%}
    {%- if url != blank -%}
      {%- assign label = network | capitalize -%}
      <li>
        <a class="suf-social__link" href="{{ url }}" target="_blank" rel="noopener">
          {% render 'suf-icon', icon: network, label: label %}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
