{% comment %}
  Inline SVG icons for net-new code. Replaces FontAwesome, which is retired.

  Usage:
    {% render 'suf-icon', icon: 'instagram' %}
    {% render 'suf-icon', icon: 'arrow-up', label: 'Back to top' %}

  Inline rather than a sprite sheet: these are a few hundred bytes, they are
  needed in the first paint, and a sprite would be another HTTP request plus a
  <use> indirection that breaks inside Shopify's section rendering API.

  Every path is currentColor, so color comes from CSS. Decorative by default
  (aria-hidden); pass `label` when the icon is the only content of a link.
{% endcomment %}
{%- liquid
  assign size = size | default: 20
  assign label = label | default: blank
-%}
<svg class="suf-icon suf-icon--{{ icon }}" width="{{ size }}" height="{{ size }}"
     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round"
     {% if label != blank %}role="img" aria-label="{{ label | escape }}"{% else %}aria-hidden="true" focusable="false"{% endif %}>
  {%- case icon -%}
    {%- when 'facebook' -%}
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
    {%- when 'instagram' -%}
      <rect x="2" y="2" width="20" height="20" rx="5"/>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
    {%- when 'twitter' -%}
      <path d="M4 4l7.5 9.7L4.4 20h1.7l6.2-6.6L17.4 20H20l-7.9-10.2L19.5 4h-1.7l-5.7 6.1L8 4z" fill="currentColor" stroke="none"/>
    {%- when 'spotify' -%}
      {%- comment -%}
        Drawn as strokes, not the usual filled Spotify glyph, so it matches the
        other icons here -- every one of them is an outline on a shared
        stroke-width. A filled path would need fill="currentColor"
        stroke="none" overriding the svg's own attributes and would read
        heavier than its neighbors at 16px.
      {%- endcomment -%}
      <circle cx="12" cy="12" r="10"/>
      <path d="M7 14.6c2.9-1 6.4-.6 8.9 1"/>
      <path d="M6.4 11.1c3.5-1.2 8-.6 11 1.4"/>
      <path d="M6 7.6c4-1.2 9.4-.5 12.9 1.8"/>
    {%- when 'youtube' -%}
      <path d="M22.5 7.4a2.7 2.7 0 0 0-1.9-1.9C18.9 5 12 5 12 5s-6.9 0-8.6.5A2.7 2.7 0 0 0 1.5 7.4 28 28 0 0 0 1 12a28 28 0 0 0 .5 4.6 2.7 2.7 0 0 0 1.9 1.9C5.1 19 12 19 12 19s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 23 12a28 28 0 0 0-.5-4.6z"/>
      <polygon points="9.8 15.1 15.5 12 9.8 8.9" fill="currentColor" stroke="none"/>
    {%- when 'linkedin' -%}
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
      <rect x="2" y="9" width="4" height="12"/>
      <circle cx="4" cy="4" r="2"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="10"/>
      <path d="M11 17l-1.5 4M12 7a4 4 0 0 0-1.6 7.7c.4-1.6 1-4 1-4"/>
    {%- when 'arrow-up' -%}
      <line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/>
    {%- when 'chevron-right' -%}
      <polyline points="9 18 15 12 9 6"/>
    {%- when 'chevron-left' -%}
      <polyline points="15 18 9 12 15 6"/>
    {%- when 'chevron-down' -%}
      <polyline points="6 9 12 15 18 9"/>
    {%- when 'cart' -%}
      <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
    {%- when 'user' -%}
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    {%- when 'close' -%}
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    {%- when 'mail' -%}
      <rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2 6 12 13 22 6"/>
    {%- when 'phone' -%}
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
    {%- when 'map-pin' -%}
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
    {%- else -%}
      {% comment %} Unknown icon name: render nothing rather than a broken box. {% endcomment %}
  {%- endcase -%}
</svg>
